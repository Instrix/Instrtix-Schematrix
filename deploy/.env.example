# Copy to deploy/.env and edit. docker compose reads it automatically.

# Required: the access token. Generate one with:  openssl rand -hex 24
SCHEMATRIX_TOKEN=

# Image: the published one (private: docker login ghcr.io first), pinned to a release tag or 'latest'
SCHEMATRIX_IMAGE=ghcr.io/instrix/instrtix-schematrix
SCHEMATRIX_VERSION=latest

# Where the server listens on this host. 127.0.0.1 = only through a reverse proxy (or an SSH tunnel);
# 0.0.0.0 = directly on the network (keep the token!)
SCHEMATRIX_BIND=127.0.0.1
SCHEMATRIX_PORT=8000

# Python scripts from the editor's Script pane run on the server: 1 = allowed, 0 = off
SCHEMATRIX_SCRIPTS=1
SCHEMATRIX_SCRIPT_TIMEOUT=30

# Container limits
SCHEMATRIX_MEMORY=1g
SCHEMATRIX_CPUS=2

# HTTPS profile only: the public name pointing at this host (ports 80 and 443 open)
SCHEMATRIX_DOMAIN=schematrix.example.com
